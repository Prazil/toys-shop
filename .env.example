# ===================================================================
# GIGGLE & BLOOM KIDS GIFT SHOP - ENVIRONMENT CONFIGURATION
# ===================================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=kids_gift_shop_super_secret_jwt_key_2026

# Merchant UPI Details (India)
MERCHANT_UPI_ID=prazilss4@oksbi
MERCHANT_NAME=Kids Gift Shop

# ===================================================================
# 1. NODEMAILER REAL SMTP CONFIGURATION
# ===================================================================
# For Gmail: Use an App Password (16 characters, 2FA enabled), SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# For Amazon SES / SendGrid: Use your SMTP host, port 587 or 465, and SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Giggle & Bloom Kids Gift Shop"
SMTP_FROM_EMAIL=

# ===================================================================
# 2. INDIAN SMS PROVIDER CONFIGURATION
# ===================================================================
# Supported SMS Providers: fast2sms | twilio | msg91 | generic
# Fast2SMS: https://www.fast2sms.com/dev/bulkV2
# DLT Requirements: Registered Entity ID, Sender ID (e.g. KIDGFT), Template ID
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=KIDGFT
SMS_TEMPLATE_ID=
SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2

# ===================================================================
# 3. GOOGLE SHEETS ORDER SYNC
# ===================================================================
# Apps Script Webhook URL for real-time 24-column order sync
GOOGLE_SHEETS_WEBHOOK_URL=

# ===================================================================
# 4. PAYMENT GATEWAY (OPTIONAL / HYBRID)
# ===================================================================
# Direct UPI QR is always enabled. Set Razorpay / Cashfree credentials here if needed.
PAYMENT_PROVIDER=UPI
PAYMENT_KEY=
PAYMENT_SECRET=
